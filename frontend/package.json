{
  "name": "tshop-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run generate:api",
    "dev": "vite",
    "pretest": "npm run generate:api",
    "generate:api": "openapi-typescript ../src/main/resources/static/openapi.yaml -o src/api/schema.d.ts",
    "build": "npm run generate:api && tsc -b && vite build",
    "typecheck": "npm run generate:api && tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.3",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
